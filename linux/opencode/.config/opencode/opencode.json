{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://pans-Mac-Studio.local:11434/v1"
      },
      "models": {
        "qwen3.6:35b": {
          "name": "qwen3.6:35b"
        }
      }
    }
  },
  "mcp": {
    "mermaid": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-mermaid"
      ]
    },
    "shortcut": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@shortcut/mcp@latest"
      ],
      "environment": {
        "SHORTCUT_API_TOKEN": "{env:SHORTCUT_API_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/secrets/context7.txt}"
      },
      "enabled": true
    }
  }
}
